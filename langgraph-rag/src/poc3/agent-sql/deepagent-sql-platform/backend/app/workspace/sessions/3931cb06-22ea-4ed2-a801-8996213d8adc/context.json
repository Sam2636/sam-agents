  "business_spec": {
    "CDP.analytics.customer_360": {
      "type": "AGGREGATE",
      "source": "FDP.banking.customers_clean",
      "columns": {
        "customer_id": "Direct mapping",
        "total_accounts": "COUNT(DISTINCT account_id)",
        "total_loans": "COUNT(DISTINCT loan_id)",
        "total_spend": "SUM(amount)",
        "spend_rank": "RANK() OVER (ORDER BY SUM(amount) DESC)"
      }
    },
    "CDP.analytics.revenue_dashboard": {
      "type": "KPI",
      "source": "CDP.analytics.customer_360",
      "columns": {
        "total_bank_revenue": "SUM(total_spend)",
        "total_transport_revenue": "SUM(total_revenue)",
        "total_interest_income": "SUM(loan_amount * avg_interest/100)",
        "top_customer": "MAX(customer_id) KEEP (DENSE_RANK FIRST ORDER BY total_spend DESC)"
      }
    },
    "CDP.analytics.transaction_summary": {
      "type": "AGGREGATE",
      "source": "FDP.finance.transactions_enriched",
      "columns": {
        "account_id": "Direct mapping",
        "total_transactions": "COUNT(transaction_id)",
        "total_credit_amount": "SUM(CASE WHEN amount > 0 THEN amount END)",
        "total_debit_amount": "SUM(CASE WHEN amount < 0 THEN amount END)",
        "account_rank": "DENSE_RANK() OVER (ORDER BY COUNT(transaction_id) DESC)"
      }
    },
    "FDP.banking.customers_clean": {
      "type": "DIMENSION",
      "source": "ODP.banking.customers_raw",
      "columns": {
        "customer_id": "Direct mapping from raw",
        "customer_rank": "RANK() OVER (ORDER BY COUNT(account_id) DESC)",
        "kyc_status": "CASE WHEN email IS NOT NULL THEN 'VERIFIED' ELSE 'PENDING' END",
        "last_updated": "MAX(created_at)"
      }
    },
    "FDP.finance.loans_enriched": {
      "type": "FACT",
      "source": "ODP.finance.loans_raw",
      "columns": {
        "loan_id": "Direct mapping",
        "risk_category": "CASE WHEN interest_rate > 12 THEN 'HIGH_RISK' ELSE 'LOW_RISK' END",
        "loan_rank": "RANK() OVER (ORDER BY loan_amount DESC)",
        "avg_interest": "AVG(interest_rate) OVER (PARTITION BY customer_id)",
        "loan_status": "CASE WHEN loan_amount > 500000 THEN 'PRIORITY' ELSE 'NORMAL' END"
      }
    },
    "FDP.finance.transactions_enriched": {
      "type": "FACT",
      "source": "ODP.finance.transactions_raw",
      "columns": {
        "transaction_id": "Direct mapping",
        "amount_category": "CASE WHEN amount > 10000 THEN 'HIGH' WHEN amount > 1000 THEN 'MEDIUM' ELSE 'LOW' END",
        "txn_rank_per_account": "RANK() OVER (PARTITION BY account_id ORDER BY amount DESC)",
        "cumulative_spend": "SUM(amount) OVER (PARTITION BY account_id ORDER BY transaction_date)"
      }
    }
  }
